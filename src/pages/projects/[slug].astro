---
import { getCollection, render } from "astro:content";
import Github from "lucide-astro/Github";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<SiteLayout
  title={`${project.data.title} | Beck Wangthumboon`}
  description={project.data.summary}
>
  <header class="mb-12">
    <a
      href="/"
      class="text-xs font-medium uppercase tracking-[0.25em] text-muted transition hover:text-accent"
    >
      &larr; Back
    </a>
    <h1
      class="mt-6 text-4xl leading-tight tracking-tight sm:text-5xl"
>
      {project.data.title}
    </h1>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted sm:text-base">
      {project.data.summary}
    </p>
    {
      project.data.repoUrl && (
        <a
          href={project.data.repoUrl}
          aria-label={`Open ${project.data.title} repository on GitHub`}
          class="mt-6 inline-flex items-center gap-2 border-b border-accent pb-1 text-sm text-accent transition hover:text-fg"
        >
          <Github aria-hidden="true" class="size-4" />
          <span class="text-xs font-medium uppercase tracking-[0.15em]">
            Source
          </span>
        </a>
      )
    }
  </header>

  {
    project.data.coverImage && (
      <section class="mb-12">
        <img
          src={project.data.coverImage}
          alt={`${project.data.title} cover image`}
          class="project-photo-main h-auto w-full border-y border-line object-cover"
          loading="eager"
        />
      </section>
    )
  }

  <article
    class="project-content flex-1 text-[0.98rem] leading-8 text-fg [&>*+*]:mt-5 [&_a]:text-accent [&_h2]:mb-3 [&_h2]:mt-12 [&_h2]:text-2xl [&_h2]:leading-tight [&_h2]:tracking-[-0.02em] [&_h3]:mb-3 [&_h3]:mt-9 [&_h3]:text-[1.2rem] [&_h3]:leading-tight [&_h3]:tracking-[-0.02em] [&_li]:text-muted [&_li::marker]:text-muted [&_p]:text-muted [&_ul]:list-disc [&_ul]:pl-5"
  >
    <Content />
  </article>

  <footer class="mt-16 border-t border-line pt-8">
    <a
      href="/"
      class="text-xs font-medium uppercase tracking-[0.25em] text-muted transition hover:text-accent"
    >
      &larr; All projects
    </a>
  </footer>
</SiteLayout>
