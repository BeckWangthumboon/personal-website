---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

const GITHUB_LINK = "https://github.com/BeckWangthumboon";
const LINKEDIN_LINK =
  "https://www.linkedin.com/in/paripon-beck-wangthumboon-34b9ba293";
const X_LINK = "https://x.com/beckthemaster";

const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort(
  (a, b) =>
    (a.data.sortOrder ?? Number.MAX_SAFE_INTEGER) -
      (b.data.sortOrder ?? Number.MAX_SAFE_INTEGER) ||
    a.data.title.localeCompare(b.data.title),
);

const contacts = [
  { label: "GitHub", href: GITHUB_LINK },
  { label: "LinkedIn", href: LINKEDIN_LINK },
  { label: "X", href: X_LINK },
];
---

<SiteLayout
  title="Beck's Projects"
  description="Projects and experiments by Beck Wangthumboon"
>
  <header class="mb-10">
    <h1 class="mt-3 text-4xl tracking-tight sm:text-5xl">Beck Wangthumboon</h1>
    <p class="pt-5 text-base tracking-wide text-muted">
      // building tools for agents
    </p>
  </header>

  <section class="flex-1">
    <ul class="space-y-3">
      {
        projects.map((project) => (
          <li>
            <a
              href={`/projects/${project.slug}`}
              class="group block rounded-card border border-line bg-panel px-5 py-4 shadow-card transition hover:-translate-y-0.5 hover:border-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              <h2 class="text-xl">{project.data.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-muted">
                {project.data.summary}
              </p>
              <p class="mt-4 text-xs uppercase tracking-[0.22em] text-accent">
                Read project
              </p>
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={LINKEDIN_LINK}
      class="mt-6 block rounded-card border border-line bg-panel px-5 py-4 text-sm text-muted shadow-card transition hover:-translate-y-0.5 hover:border-accent hover:text-fg"
    >
      Like my work? Hire me ->
    </a>
  </section>

  <footer class="mt-12 border-t border-line pt-6">
    <ul class="flex flex-wrap gap-x-5 gap-y-3 text-sm">
      {
        contacts.map((contact) => (
          <li>
            <a href={contact.href} class="text-muted hover:text-accent">
              {contact.label}
            </a>
          </li>
        ))
      }
    </ul>
  </footer>
</SiteLayout>
