---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

const GITHUB_LINK = "https://github.com/BeckWangthumboon";
const LINKEDIN_LINK =
  "https://www.linkedin.com/in/paripon-beck-wangthumboon-34b9ba293";
const X_LINK = "https://x.com/beckthemaster";

const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort(
  (a, b) =>
    (a.data.sortOrder ?? Number.MAX_SAFE_INTEGER) -
      (b.data.sortOrder ?? Number.MAX_SAFE_INTEGER) ||
    a.data.title.localeCompare(b.data.title),
);

const contacts = [
  { label: "GitHub", href: GITHUB_LINK },
  { label: "LinkedIn", href: LINKEDIN_LINK },
  { label: "X", href: X_LINK },
];
---

<SiteLayout
  title="Beck's Projects"
  description="Projects and experiments by Beck Wangthumboon"
>
  <header class="mb-16">
    <p
      class="mb-4 text-xs font-medium uppercase tracking-[0.3em] text-muted"
    >
      Portfolio
    </p>
    <h1
      class="text-5xl leading-tight tracking-tight sm:text-6xl"
>
      Beck Wangthumboon
    </h1>
    <p class="mt-5 text-base tracking-wide text-muted">
      I like building things
    </p>
  </header>

  <section class="flex-1">
    <div>
      {
        projects.map((project) => (
          <a
            href={`/projects/${project.slug}`}
            class="group block py-8 transition"
          >
            <h2
              class="text-2xl tracking-tight transition group-hover:text-accent sm:text-3xl"
                >
              {project.data.title}
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-muted">
              {project.data.summary}
            </p>
            <p class="mt-4 text-xs font-medium uppercase tracking-[0.25em] text-accent opacity-0 transition group-hover:opacity-100">
              Read more
            </p>
          </a>
        ))
      }
    </div>

    <a
      href={LINKEDIN_LINK}
      class="mt-12 inline-block border-b border-accent pb-1 text-sm text-muted transition hover:text-accent"
    >
      Like my work? Hire me &rarr;
    </a>
  </section>

  <footer class="mt-20 border-t border-line pt-8">
    <ul class="flex gap-x-8 text-xs uppercase tracking-[0.2em]">
      {
        contacts.map((contact) => (
          <li>
            <a
              href={contact.href}
              class="text-muted transition hover:text-accent"
            >
              {contact.label}
            </a>
          </li>
        ))
      }
    </ul>
  </footer>
</SiteLayout>
